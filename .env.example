# PostgreSQL is used in development and production after the DB transition.

# Use the pooled runtime URL from the same Supabase project as Realtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"

# Optional: use a direct, non-pooling URL for Prisma migrations when your
# provider gives separate pooled and direct URLs.
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"

# Use a long random secret in production. Do not reuse this placeholder.
AUTH_SECRET="replace-with-a-long-random-secret"

# Server scheduler authentication: use a separate random secret of at least 16 characters.
# Set CRON_SECRET in the production host before enabling the resource-maintenance cron.
# vercel.json calls GET /api/internal/resource-maintenance daily (18:00 UTC).
# CRON_SECRET=""
# Prefer a dedicated push secret so resource maintenance and push can be configured independently.
# GET /api/mobile/push-dispatch every 15 minutes with Authorization: Bearer <MOBILE_PUSH_CRON_SECRET>.
# For existing installations only, push falls back to CRON_SECRET when this variable is absent.
# MOBILE_PUSH_CRON_SECRET=""
# Optional when Expo push access-token security is enabled for the EAS project.
# EXPO_ACCESS_TOKEN=""

# Required for the authenticated lunch-box realtime stream.
# The service role key stays on the server and must never use NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Local development can use local disk.
# Production recommendation: Supabase Storage private bucket.
ATTACHMENT_STORAGE_DRIVER="local"

# ATTACHMENT_STORAGE_DRIVER="supabase-storage"
# SUPABASE_STORAGE_BUCKET="approval-attachments"

# Vercel Blob is still supported if you prefer it.
# ATTACHMENT_STORAGE_DRIVER="vercel-blob"
# BLOB_READ_WRITE_TOKEN=""

# Optional: encrypt attachment files at rest (incl. youth decision documents).
# When set, newly uploaded files are AES-256-GCM encrypted before storage and
# decrypted on download; existing plaintext files keep working. Generate with:
#   openssl rand -base64 32
# IMPORTANT: keep this key in the app host env only (NOT in the storage
# provider), and back it up — if it is lost, existing encrypted files cannot be
# recovered. Rotating it makes previously stored files unreadable.
# ATTACHMENT_ENCRYPTION_KEY=""

# One-time production admin creation script.
# INITIAL_ADMIN_EMAIL=""
# INITIAL_ADMIN_PASSWORD=""
# INITIAL_ADMIN_NAME="운영 관리자"
