test("server 413 preserves original input and technical limit appears only as actionable error", async () => { const scope = await mount("editor"); assert.equal(output(scope).includes("전송 데이터는 8MiB"), false); change(scope, "content", "보관할 긴 입력"); state.onRequest = async () => { throw new ApiError("전송 데이터가 8MiB를 넘습니다. 입력은 보관됩니다.", 413, { content: "내용을 나누어 저장하세요." }); }; await press(scope, "일정 수정 저장"); assert.equal(field(scope, "content")?.props.value, "보관할 긴 입력"); assert.equal(field(scope, "content")?.props.error, "내용을 나누어 저장하세요."); assert.ok(feedback(scope, "error").some((message: string) => message.includes("8MiB"))); assert.equal(button(scope, "일정 수정 저장").props.disabled, false); });
test("new conflict exact candidate clears obsolete fields and explicit adoption saves by the confirmed ID", async () => {
  state.item = null; const scope = await mount("editor", { id: undefined }); change(scope, "content", "같은 일정");
  state.onRequest = async (path: string, options: Row) => {
    if (options.method === "POST") { saved(options.body, "POST"); throw new ApiError("수동 일정이 겹칩니다.", 409, { startMinute: "수동 일정이 겹칩니다." }); }
    return pageResponse(path);
  };
  await press(scope, "일정 등록"); assert.equal(field(scope, "startTime")?.props.error, "수동 일정이 겹칩니다.");
  await press(scope, "최신 일정 확인"); assert.equal(field(scope, "startTime")?.props.error, undefined); assert.equal(feedback(scope, "error").length, 0); assert.ok(output(scope).includes("이 요청으로 등록됐는지는 확인할 수 없습니다"));
  await press(scope, "기존 일정 수정으로 전환"); assert.equal(field(scope, "startTime")?.props.error, undefined); assert.equal(button(scope, "일정 수정 저장").props.disabled, false);
  state.onRequest = async (_path: string, options: Row) => options.method === "PUT" ? saved(options.body, "PUT") : manualResponse();
  change(scope, "content", "기존 일정 수정 내용"); await press(scope, "일정 수정 저장"); assert.equal(mutations("POST").length, 1); assert.equal(mutations("PUT")[0].path, "/schedules/manual/new-manual"); assert.equal(mutations("PUT")[0].body.expectedUpdatedAt, "2026-10-03T00:00:00.001Z"); assert.equal(field(scope, "startTime")?.props.error, undefined); assert.ok(feedback(scope, "message").includes("일정을 저장했습니다.")); assert.equal(button(scope, "일정 수정 저장").props.disabled, false);
});
