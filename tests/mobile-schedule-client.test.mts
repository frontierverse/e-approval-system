test("readonly removed/retained target disappears and malformed date never switches today", async () => { state.extraItems = [hospitalItem()]; const scope = await mount("detail", { id: "hospital-appointment:appointment" }); state.extraItems = []; await press(scope, "최신 일정 확인"); assert.equal(nodes(scope.tree).some(node => node.type === "WorkScheduleContent"), false); state.requests = []; await mount("detail", { date: "" }); assert.equal(state.requests.length, 0); });
test("delete duplicate approval sends original ID/token once and confirms shared permanent impact", async () => { const scope = await mount("detail"); const pending = deferred(); state.onRequest = () => pending.promise; const action = button(scope, "일정 삭제").props.onPress; action(); action(); await tick(); assert.equal(mutations("DELETE").length, 1); assert.deepEqual(mutations("DELETE")[0].body, { expectedUpdatedAt: "2026-10-03T00:00:00.000Z" }); assert.equal(mutations("DELETE")[0].path, "/schedules/manual/manual-a"); assert.match(state.confirmations[0].message, /다른 직원에게도/); assert.match(state.confirmations[0].message, /복구할 수 없습니다/); pending.reject(new ApiError("응답 손실", 0)); await tick(); action(); assert.equal(mutations("DELETE").length, 1); });
test("delete canceled or stale modal approvals do not mutate after focus/account rollover", async () => { const scope = await mount("detail"); state.confirmation = false; await press(scope, "일정 삭제"); assert.equal(mutations("DELETE").length, 0); const question = deferred(); state.confirmation = question.promise; button(scope, "일정 삭제").props.onPress(); scope.blur(); scope.refocus(); await tick(); update(scope); question.resolve(true); await tick(); assert.equal(mutations("DELETE").length, 0); });
test("unknown DELETE 404 confirms only old ID absence and never deletes a replacement", async () => { const scope = await mount("detail"); state.onRequest = async (_path: string, options: Row) => { if (options.method === "DELETE") { state.item = null; throw new ApiError("응답 손실", 0); } throw new ApiError("일정 없음", 404); }; await press(scope, "일정 삭제"); await press(scope, "최신 일정 확인"); assert.equal(mutations("DELETE").length, 1); assert.ok(feedback(scope, "message").some((message: string) => message.includes("새로 등록된 다른 일정은 삭제하지 않았습니다"))); assert.equal(nodes(scope.tree).some(node => node.props?.title === "일정 삭제"), false); });
test("409 DELETE reads moved latest ID and next explicit confirmation uses latest timestamp", async () => { const scope = await mount("detail"); state.onRequest = async () => { throw new ApiError("충돌", 409); }; await press(scope, "일정 삭제"); state.item = initialItem({ scheduleDate: "2026-11-02", updatedAt: "2026-10-03T00:00:00.003Z" }); state.onRequest = async (_path: string, options: Row) => options.method === "DELETE" ? deleted() : manualResponse(); await press(scope, "최신 일정 확인"); await press(scope, "일정 삭제"); assert.equal(mutations("DELETE")[1].body.expectedUpdatedAt, "2026-10-03T00:00:00.003Z"); assert.match(state.confirmations.at(-1).message, /2026년 11월 2일/); });
test("known deleted/missing results survive failed follow-up GET and do not retain original body", async () => { const scope = await mount("detail"); state.onRequest = async (_path: string, options: Row) => { if (options.method === "DELETE") return deleted(); throw new ApiError("후속 장애", 503); }; await press(scope, "일정 삭제"); await tick(); update(scope); assert.ok(feedback(scope, "message").includes("일정을 삭제했습니다.")); assert.ok(feedback(scope, "error").includes("후속 장애")); assert.equal(output(scope).includes("기존 공용 내용"), false); });
test("fresh detail permission mask survives 503 and old edit callback cannot navigate", async () => { const scope = await mount("detail"); const edit = button(scope, "일정 수정").props.onPress; const pending = deferred(); state.onRequest = () => pending.promise; scope.blur(); scope.refocus(); update(scope); edit(); assert.equal(state.routes.length, 0); assert.equal(nodes(scope.tree).some(node => node.type === "WorkScheduleContent"), false); pending.reject(new ApiError("권한 조회 장애", 503)); await tick(); update(scope); assert.equal(nodes(scope.tree).some(node => node.type === "WorkScheduleContent"), false); });
test("late detail deletion from switched account cannot set success", async () => { const scope = await mount("detail"); const pending = deferred(); state.onRequest = () => pending.promise; button(scope, "일정 삭제").props.onPress(); await tick(); state.account = "account-b"; pending.resolve({ ok: true, change: "deleted", message: "늦은 삭제 성공", deletedId: "manual-a" }); await tick(); update(scope); assert.equal(feedback(scope, "message").includes("늦은 삭제 성공"), false); });
test("history authenticates safe five-page/date/actor query and expands permitted snapshots", async () => { const scope = await mount("history"); assert.equal(state.requests[0].path, "/schedules/changes?page=1&actorId=all&date=2026-10-03"); assert.ok(output(scope).includes("페이지 · 5건씩")); await press(scope, "변경 내용 펼치기"); assert.equal(nodes(scope.tree).filter(node => node.type === "WorkScheduleSnapshot").length, 2); await press(scope, "조회 조건 펼치기"); await press(scope, "직원 가"); assert.equal(state.requests.at(-1).path, "/schedules/changes?page=1&actorId=staff-a&date=2026-10-03"); });
test("history invalid route, source error, account/focus rollover never show stale sensitive logs", async () => { const bad = await mount("history", { date: "" }); assert.equal(state.requests.length, 0); assert.ok(feedback(bad, "error").length); const scope = await mount("history"); const pending = deferred(); state.onRequest = () => pending.promise; scope.blur(); scope.refocus(); update(scope); assert.equal(output(scope).includes("등록했습니다"), false); pending.reject(new ApiError("장애", 503)); await tick(); update(scope); assert.equal(output(scope).includes("등록했습니다"), false); });
test("StrictMode effect cleanup generations reject an earlier manual response", async () => { const reads: Row[] = []; state.onRequest = () => { const pending = deferred(); reads.push(pending); return pending.promise; }; const scope = new Hooks("editor"); scopes.push(scope); scope.render(); scope.flush(); scope.replay(); reads[0].resolve({ today: state.today, item: initialItem({ content: "이전 세대 응답" }) }); await tick(); update(scope); assert.equal(field(scope, "content"), undefined); reads.at(-1)!.resolve(manualResponse()); await tick(); update(scope); assert.equal(field(scope, "content")?.props.value, "기존 공용 내용"); });
