class Screen{slots:Row[]=[];index=0;effects:Row[]=[];scheduled:Array<()=>void>=[];jobs:Promise<unknown>[]=[];nodes:Row[]=[];tree:Row|null=null;mounted=true;props:Row;
 constructor(extra:Row={}){this.props={actorId:'actor',modal:{mode:'edit',youth:structuredClone(youth),canDelete:false},permissions:{...permissions},createYouth:async(...args:unknown[])=>{h.calls.push(['create',...args]);return h.api.create(...args);},updateYouth:async(...args:unknown[])=>{h.calls.push(['update',...args]);return h.api.update(...args);},deleteYouth:async()=>{},deleteDecisionDocument:async()=>{},onClose:()=>h.calls.push(['close']),onSaved:(value:unknown)=>h.calls.push(['saved',value]),onDeleted:()=>{},onDecisionDocumentDownload:()=>{},mutationStatus:async(...args:unknown[])=>{h.calls.push(['status',...args]);return h.api.status(...args);},loadEditor:async(...args:unknown[])=>{h.calls.push(['editor',...args]);return h.api.editor(...args);},recordYouthContactView:async()=>({ok:true,data:{phone:'010-1234-5678',familyContacts:[{id:'family',relationship:'보호자',phone:'010-2222-3333'}]}}),...extra};this.render();}
 render(){this.index=0;this.scheduled=[];h.current=this;this.tree=YouthRosterFormModal(this.props);this.nodes=walk(this.tree);for(const effect of this.scheduled)effect();return this;}
