test('unknown transport keeps exact key/body/files and resolves own receipt before redispatch',async()=>{h.api.update=async()=>{throw Error('PRIVATE_NETWORK');};const screen=new Screen();screen.file(new File(['safe'],'가상.pdf',{type:'application/pdf'}));screen.changeName('입력 보존');screen.submit();await screen.flush();const first=h.calls.find((c:Row)=>c[0]==='update');screen.changeName('불명확 중 변경');screen.props.modal.youth.updatedAt=fresh;screen.render();screen.submit();await screen.flush();const updates=h.calls.filter((c:Row)=>c[0]==='update');assert.equal(updates.length,2);assert.equal(updates[1][2],first[2]);assert.equal(updates[1][3],first[3]);assert.equal(updates[1][2].name,'입력 보존');assert.equal(updates[1][2].expectedUpdatedAt,baseline);assert.deepEqual(h.calls.filter((c:Row)=>['update','status'].includes(c[0])).map((c:Row)=>c[0]),['update','status','update']);assert.doesNotMatch(text(screen.tree),/PRIVATE_NETWORK/);screen.unmount();});
