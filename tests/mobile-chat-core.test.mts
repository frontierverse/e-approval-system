import assert from "node:assert/strict";
import { test } from "node:test";
import { ApiError } from "../mobile/src/lib/api";
import { chatRouteId,chatUnknownResult,compareChatSequence,isChatAttachment,isChatEmployee,isChatFilePolicy,isChatMessagePage,isChatReceiptStatus,isChatSummary,isChatUploadStatus,mergeChatMessages } from "../mobile/src/lib/chat";
const employee={id:"peer",name:"직원",departmentName:"지원",positionName:"담당",active:true};
const message=(sequence="9007199254740993",patch:Record<string,unknown>={})=>({id:`message-${sequence}`,sequence,senderId:"peer",recipientId:"own",body:"확인",createdAt:"2026-10-03T00:00:00.000Z",readAt:null,...patch});
test("sequences preserve values beyond safe Number range",()=>{assert.ok(compareChatSequence("9007199254740993","9007199254740992")>0);assert.ok(compareChatSequence("100000000000000000000","99999999999999999999")>0);assert.equal(chatRouteId(["peer"]),"");});
test("message pages reject foreign scope, reversed sequence, duplicate IDs and numeric sequence",()=>{assert.ok(isChatMessagePage({messages:[message()],hasMore:false},"own","peer"));for(const messages of [[message("2"),message("1")],[message("1"),message("2",{id:"message-1"})],[message("1",{recipientId:"another"})],[message("1",{sequence:1})]])assert.equal(isChatMessagePage({messages,hasMore:false},"own","peer"),false);});
test("summary includes inactive historical peer and strictly balanced unread count",()=>{const value={employees:[employee],conversations:[{peer:{...employee,active:false},lastMessage:message(),unreadCount:4}],unreadCount:4};assert.ok(isChatSummary(value,"own"));assert.equal(isChatSummary({...value,unreadCount:0},"own"),false);assert.equal(isChatSummary({...value,employees:[{...employee,active:false}]},"own"),false);assert.equal(isChatEmployee({...employee,secret:"private"}),false);});
test("latest messages refresh read/file status and reset gaps without bridging unobserved pages",()=>{const before=[message("1"),message("2")];const overlap=mergeChatMessages(before,{messages:[message("2",{readAt:"2026-10-03T00:01:00.000Z"}),message("3")],hasMore:true});assert.equal(overlap.gap,false);assert.equal(overlap.messages.length,3);assert.equal(overlap.messages[1].readAt,"2026-10-03T00:01:00.000Z");const gap=mergeChatMessages(before,{messages:[message("99")],hasMore:true});assert.equal(gap.gap,true);assert.deepEqual(gap.messages.map(m=>m.sequence),["99"]);});
test("files never expose internal fields and receipt token stays outside DTO",()=>{assert.ok(isChatAttachment({id:"file",originalName:"기록.pdf",size:12,status:"available"}));assert.equal(isChatAttachment({id:"file",originalName:"기록.pdf",size:12,status:"available",token:"secret"}),false);assert.ok(isChatReceiptStatus({match:true,status:"deleted"}));assert.equal(isChatReceiptStatus({match:true,status:"deleted",token:"secret"}),false);assert.ok(isChatUploadStatus({uploadId:"12345678-abcd-1234-abcd-123456789abc",uploadedParts:[0,24]}));assert.equal(isChatUploadStatus({uploadId:"12345678-abcd-1234-abcd-123456789abc",uploadedParts:[0,0]}),false);assert.equal(isChatUploadStatus({uploadId:"12345678-abcd-1234-abcd-123456789abc",uploadedParts:[24,0]}),false);});
test("file policy is one file, bounded general input and 4MiB ZIP chunks",()=>{const p={maxFileSize:4*1024*1024,zipMaxFileSize:100*1024*1024,uploadChunkSize:4*1024*1024,maxFileCount:1,allowedExtensions:[".zip",".pdf"]};assert.ok(isChatFilePolicy(p));assert.equal(isChatFilePolicy({...p,uploadChunkSize:100*1024*1024}),false);assert.equal(isChatFilePolicy({...p,allowedExtensions:["zip"]}),false);});
test("all malformed success and connection/server failures retain original send key",()=>{for(const status of [0,200,201,204,408,500,503])assert.ok(chatUnknownResult(new ApiError("실패",status)));for(const status of [400,403,413,415])assert.equal(chatUnknownResult(new ApiError("실패",status)),false);});
