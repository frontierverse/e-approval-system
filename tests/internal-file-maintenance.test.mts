import assert from 'node:assert/strict';
import { test } from 'node:test';
import { maintenanceHarness, settle } from './helpers/internal-file-maintenance.mjs';
test('all held lanes retain independent reservations and finish within40s',async()=>{const f=maintenanceHarness(),{h}=f;for(const lane of Object.keys(h.results))h.behaviors[lane]=()=>new Promise(()=>{});const work=f.engine().runInternalFileMaintenance();await settle();for(const ms of[4000,1000,3000,2000])await f.advance(ms);const result=await work;assert.equal(h.clock,10000);assert.equal(result.ok,false);assert.equal(h.calls.length,4);assert(Object.values(result.lanes).every((lane:{timedOut:boolean;batches:number})=>lane.timedOut&&lane.batches===1));assert.equal(f.timers.size,0);});
test('four rounds consume at most40s and preserve5s overall reserve',async()=>{const f=maintenanceHarness(),{h}=f;for(const lane of Object.keys(h.results))h.behaviors[lane]=({options})=>{h.clock+=options.budgetMs;return h.results[lane];};const result=await f.engine().runInternalFileMaintenance();assert.equal(h.clock,40000);assert.equal(h.calls.length,16);assert.equal(result.ok,true);});
test('45s deadline prevents any later lane dispatch',async()=>{const f=maintenanceHarness(),{h}=f;h.behaviors.resource=()=>{h.clock=45000;return h.results.resource;};const result=await f.engine().runInternalFileMaintenance();assert.equal(h.calls.length,1);assert.equal(result.ok,false);assert.equal(result.completed,0);});
test('malformed domain counters never aggregate and other lanes still run',async()=>{const f=maintenanceHarness(),{h}=f;h.results.youthExpiry={checked:-1,expired:2};const result=await f.engine().runInternalFileMaintenance();assert.equal(result.ok,false);assert.equal(result.lanes.youthExpiry.checked,0);assert.equal(result.lanes.youthExpiry.expired,0);assert.equal(result.lanes.approvedPurge.batches,4);});
