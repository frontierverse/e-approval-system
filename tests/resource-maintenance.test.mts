import assert from 'node:assert/strict';
import { after, afterEach, beforeEach, describe, test } from 'node:test';
import { NextRequest } from 'next/server';
import { proxy } from '../src/proxy.ts';
import { maintenanceHarness, settle } from './helpers/internal-file-maintenance.mjs';
const secret='synthetic-cron-secret-only',originalSecret=process.env.CRON_SECRET,originalNow=Date.now;
const request=(authorization?:string,signal?:AbortSignal)=>new Request('https://fixture.invalid/api/internal/resource-maintenance?invalid=%xx',{method:'POST',body:'not-json',signal,headers:{...(authorization?{authorization}:{}),'content-type':'multipart/form-data; malformed'}});
const privacy=(response:Response)=>{assert.equal(response.headers.get('cache-control'),'private, no-store');assert.equal(response.headers.get('vary'),'Authorization');assert.equal(response.headers.get('x-content-type-options'),'nosniff');assert.equal(response.headers.get('location'),null);};
describe('actual authenticated maintenance route and four reserved domains',()=>{
 beforeEach(()=>{process.env.CRON_SECRET=secret;});
 afterEach(()=>{assert.equal(Date.now,originalNow);});
 after(()=>{if(originalSecret===undefined)delete process.env.CRON_SECRET;else process.env.CRON_SECRET=originalSecret;});
 test('invalid Cron credentials import no dispatcher/domain and ignore arbitrary body/query',async()=>{const{h,route}=maintenanceHarness();for(const configured of[undefined,'short',secret])for(const auth of[undefined,'Bearer invalid','bearer '+secret,'Bearer '+secret+'extra']){if(configured===undefined)delete process.env.CRON_SECRET;else process.env.CRON_SECRET=configured;const response=await route.GET(request(auth));assert.equal(response.status,401);privacy(response);assert.equal((await response.json()).code,'UNAUTHORIZED');}assert.equal(h.imports.length,0);assert.equal(h.calls.length,0);});
 test('actual proxy reaches exact Cron path with no cookie; failed auth stays private401/import0',async()=>{const{route,h}=maintenanceHarness();for(const auth of[undefined,'Bearer invalid']){const req=new NextRequest('https://fixture.invalid/api/internal/resource-maintenance',{headers:auth?{authorization:auth}:{}});const next=proxy(req);assert.equal(next.headers.get('x-middleware-next'),'1');assert.equal(next.headers.get('location'),null);const response=await route.GET(req);assert.equal(response.status,401);privacy(response);}assert.equal(h.imports.length,0);});
 test('exact Cron auth interleaves four capped rounds and preserves resource totals',async()=>{const{route,h,timers}=maintenanceHarness();const response=await route.GET(request('Bearer '+secret));assert.equal(response.status,200);privacy(response);const result=await response.json();assert.equal(result.checked,40);assert.equal(result.completed,12);assert.equal(result.ok,true);assert.deepEqual(h.calls.map(c=>c.lane),Array.from({length:4},()=>['resource','youthExpiry','youthQueue','approvedPurge']).flat());for(const call of h.calls){const expected={resource:[10,4000],youthExpiry:[3,1000],youthQueue:[5,3000],approvedPurge:[2,2000]}[call.lane];assert.deepEqual([call.options.limit,call.options.budgetMs],expected);assert.deepEqual(call.context,{});assert.equal(call.options.signal.aborted,false);}assert.equal(result.lanes.approvedPurge.pending,8);assert.equal(route.maxDuration,60);assert.equal(route.dynamic,'force-dynamic');assert.equal(timers.size,0);});
 test('each empty lane stops independently without blocking normal pending purge',async()=>{const{route,h}=maintenanceHarness();h.results.resource={checked:0,completed:0};h.results.youthExpiry={checked:0,expired:0};h.results.youthQueue={checked:0,completed:0};const response=await route.GET(request('Bearer '+secret));assert.equal(response.status,200);const result=await response.json();assert.equal(result.ok,true);assert.equal(result.lanes.approvedPurge.batches,4);assert.equal(h.calls.length,7);});
 test('domain error is safe500 only after other reserved lanes finish',async()=>{const{route,h}=maintenanceHarness();h.behaviors.resource=()=>{throw Error('PRIVATE_PROVIDER_KEY_URL');};const response=await route.GET(request('Bearer '+secret));assert.equal(response.status,500);privacy(response);const result=await response.json();assert.equal(h.calls.filter(c=>c.lane==='resource').length,1);assert.equal(h.calls.filter(c=>c.lane==='approvedPurge').length,4);assert.equal(result.lanes.resource.failed,true);assert.doesNotMatch(JSON.stringify(result),/PRIVATE|PROVIDER|storage|https/);});
 test('held lane times out once and cannot publish a late completed result',async()=>{const fixture=maintenanceHarness(),{h,route}=fixture;let release:(value:unknown)=>void=()=>{};h.behaviors.resource=()=>new Promise(resolve=>{release=resolve;});const work=route.GET(request('Bearer '+secret));await settle();await fixture.advance(4000);const response=await work;assert.equal(response.status,500);const result=await response.json();assert.equal(result.checked,0);assert.equal(result.completed,0);assert.equal(h.calls.filter(c=>c.lane==='resource').length,1);assert.equal(h.calls.filter(c=>c.lane==='approvedPurge').length,4);assert.equal(result.lanes.resource.timedOut,true);assert.equal(h.calls[0].options.signal.aborted,true);release({checked:10,completed:10});await settle();assert.equal(result.completed,0);});
 test('forty grant-gated resource expiration candidates still advance all four batches',async()=>{const{route,h}=maintenanceHarness();let remaining=40;h.behaviors.resource=()=>{const expired=Math.min(10,remaining);remaining-=expired;return{checked:0,completed:0,expired};};const response=await route.GET(request('Bearer '+secret));assert.equal(response.status,200);const result=await response.json();assert.equal(remaining,0);assert.equal(result.lanes.resource.expired,40);assert.equal(result.completed,0);assert.equal(result.lanes.youthQueue.batches,4);assert.equal(result.lanes.approvedPurge.batches,4);});
 test('caller cancellation starts no new domain and does not claim physical completion',async()=>{const{route,h}=maintenanceHarness(),controller=new AbortController();controller.abort();const response=await route.GET(request('Bearer '+secret,controller.signal));assert.equal(response.status,500);assert.equal(h.calls.length,0);const result=await response.json();assert.equal(result.completed,0);});
});
