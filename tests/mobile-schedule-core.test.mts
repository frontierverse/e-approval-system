import assert from "node:assert/strict";
import { test } from "node:test";
import * as schedules from "../mobile/src/lib/schedules";
import type { MobileManualSchedule, MobileScheduleItem } from "../mobile/src/lib/types";
const stamp = "2026-10-03T00:00:00.000Z";
const manual = (patch: Partial<MobileManualSchedule> = {}): MobileManualSchedule => ({ id: "manual-a", sourceType: "manual", readOnly: false, allDay: false, scheduleDate: "2026-10-03", startMinute: 540, endMinute: 600, content: "공용 업무", updatedAt: stamp, ...patch });
const vacation: MobileScheduleItem = { id: "approved-vacation:document:2026-10-03", sourceType: "approvedVacation", readOnly: true, allDay: true, scheduleDate: "2026-10-03", content: "직원 연차", staffName: "직원", vacationLabel: "연차", departmentName: "운영", positionName: "직원" };
const hospital: MobileScheduleItem = { id: "hospital-appointment:appointment", sourceType: "hospitalAppointment", readOnly: true, allDay: false, scheduleDate: "2026-10-04", startMinute: 0, endMinute: 1440, content: "병원 진료", youthName: "청소년", hospitalName: "병원", escortName: "직원" };
const page = (items: MobileScheduleItem[] = [manual(), vacation, hospital]) => ({ today: "2026-10-03", month: "2026-10", selectedDate: "2026-10-03", canManage: true, items, monthCounts: schedules.scheduleCounts(items), selectedCounts: schedules.scheduleCounts(schedules.selectedScheduleItems(items, "2026-10-03")) });
test("explicit scalar dates preserve input and duplicate arrays never become a different today", () => { assert.equal(schedules.scheduleDate(undefined), undefined); for (const value of [["2026-10-03"], null, 1, {}]) assert.equal(schedules.scheduleDate(value), ""); assert.equal(schedules.scheduleDate(" 2026-10-03"), " 2026-10-03"); assert.equal(schedules.scheduleDate(""), ""); });
test("canonical Gregorian dates cover years 0001 to 9999 and shifts do not wrap", () => {
  for (const date of ["0001-01-01", "0099-02-28", "2000-02-29", "9999-12-31"]) assert.equal(schedules.isScheduleDate(date), true, date);
  for (const date of ["0000-01-01", "1900-02-29", "2026-02-30", "2026-1-01", "10000-01-01"]) assert.equal(schedules.isScheduleDate(date), false, date);
  assert.equal(schedules.shiftScheduleDate("0001-01-01", -1), null); assert.equal(schedules.shiftScheduleDate("9999-12-31", 1), null); assert.equal(schedules.shiftScheduleMonth("0001-01", -1), null); assert.equal(schedules.shiftScheduleMonth("9999-12", 1), null); assert.equal(schedules.shiftScheduleDate("2024-02-28", 1), "2024-02-29");
});
test("42 Sunday-first calendar cells explicitly disable overflowing boundary dates", () => { const cells = schedules.scheduleCalendar("2026-10"); assert.equal(cells.length, 42); assert.equal(cells[0].date, "2026-09-27"); assert.equal(cells.filter(cell => cell.inMonth).length, 31); assert.equal(schedules.scheduleCalendar("0001-01")[0].date, null); assert.ok(schedules.scheduleCalendar("9999-12").some(cell => cell.date === null)); assert.deepEqual(schedules.scheduleCalendar("invalid"), []); });
test("pagination accepts all positive safe integers without a new 100000 cap", () => { assert.equal(schedules.schedulePage("100001"), 100001); assert.equal(schedules.schedulePage(Number.MAX_SAFE_INTEGER), Number.MAX_SAFE_INTEGER); assert.equal(schedules.schedulePage(String(Number.MAX_SAFE_INTEGER + 1)), 1); assert.equal(schedules.schedulePage(["2"]), 1); assert.equal(schedules.schedulePage(0), 1); });
test("times and source DTOs distinguish manual limits, hospital full day, vacation without sentinel", () => { assert.equal(schedules.isManualSchedule(manual()), true); assert.equal(schedules.isManualSchedule(manual({ startMinute: 0, endMinute: 1440 })), false); assert.equal(schedules.isScheduleItem(hospital), true); assert.equal(schedules.isScheduleItem(vacation), true); assert.equal(schedules.isScheduleItem({ ...vacation, startMinute: -1000 }), false); assert.equal(schedules.formatScheduleMinute(1440), "24:00"); assert.equal(schedules.parseScheduleTime("24:10"), null); assert.equal(schedules.parseScheduleTime("9:00"), null); });
test("DTO predicates reject extra private keys and derived IDs in manual mutation DTO", () => { assert.equal(schedules.isScheduleItem({ ...manual(), authorId: "private" }), false); assert.equal(schedules.isScheduleItem({ ...vacation, reason: "private" }), false); assert.equal(schedules.isManualSchedule(manual({ id: "hospital-appointment:x" })), false); assert.equal(schedules.isManualSchedule(manual({ updatedAt: "2026-10-03T00:00:00Z" })), false); });
test("monthly/day counts and exact query normalization are verified independently", () => { assert.equal(schedules.isSchedulePage(page()), true); assert.equal(schedules.isSchedulePage({ ...page(), selectedCounts: page().monthCounts }), false); assert.equal(schedules.isSchedulePage({ ...page(), selectedDate: "2026-10-04" }), false); assert.equal(schedules.isSchedulePage({ ...page(), selectedDate: "2026-10-04", selectedCounts: schedules.scheduleCounts([hospital]) }, { date: "2026-10-04" }), true); assert.equal(schedules.isSchedulePage({ ...page(), items: [manual(), manual()] }), false); });
test("future dates and long existing content remain valid without semantic character caps", () => { const input = schedules.scheduleSaveInput({ scheduleDate: "2027-01-01", startTime: "09:00", endTime: "18:00", content: "가".repeat(12000) }, null); assert.deepEqual(schedules.validateScheduleInput(input), {}); assert.ok(schedules.validateScheduleInput({ ...input, content: " " }).content); assert.ok(schedules.validateScheduleInput({ ...input, startMinute: 539 }).startMinute); assert.ok(schedules.validateScheduleInput({ ...input, endMinute: 1081 }).endMinute); });
test("serialized UTF8 size matches actual bytes including emoji, escapes and lone surrogates", () => { for (const content of ["가나다", "😀😀", "\ud800", "\n\"\\", "a"]) { const input = schedules.scheduleSaveInput({ scheduleDate: "2026-10-03", startTime: "09:00", endTime: "10:00", content }, null); assert.equal(schedules.scheduleBodyBytes(input), Buffer.byteLength(JSON.stringify(input), "utf8")); } const tooLarge = schedules.scheduleSaveInput({ scheduleDate: "2026-10-03", startTime: "09:00", endTime: "10:00", content: "가".repeat(2800000) }, null); assert.match(schedules.validateScheduleInput(tooLarge).content, /8MiB/); });
test("new POST and known PUT keep separate strict payloads and original exact baseline", () => { const old = manual(); const input = schedules.scheduleSaveInput(schedules.scheduleValues(old, old.scheduleDate), old); assert.equal(input.manualScheduleId, "manual-a"); assert.equal(input.expectedUpdatedAt, stamp); assert.equal(Object.hasOwn(schedules.scheduleUpdateInput(input), "manualScheduleId"), false); assert.ok(schedules.validateScheduleInput({ ...input, expectedUpdatedAt: "2026-10-03T00:00:00Z" }).expectedUpdatedAt); });
test("new matching data never proves unknown POST ownership", () => { const input = schedules.scheduleSaveInput(schedules.scheduleValues(manual(), "2026-10-03"), null); assert.equal(schedules.schedulePayloadMatches(manual(), input), true); assert.equal(schedules.scheduleSavedMatches(manual(), input, null), false); });
test("known unknown PUT matches require original ID and changed token or actual unchanged baseline", () => { const old = manual(); const input = schedules.scheduleSaveInput({ ...schedules.scheduleValues(old, old.scheduleDate), content: "변경" }, old); const newer = manual({ content: input.content, updatedAt: "2026-10-03T00:00:00.001Z" }); assert.equal(schedules.scheduleSavedMatches(newer, input, old), true); assert.equal(schedules.scheduleSavedMatches({ ...newer, id: "new-id" }, input, old), false); assert.equal(schedules.scheduleSavedMatches({ ...newer, updatedAt: stamp }, input, old), false); assert.equal(schedules.scheduleSavedMatches(old, schedules.scheduleSaveInput(schedules.scheduleValues(old, old.scheduleDate), old), old), true); });
test("mutation/delete acknowledgement rejects changed ID/token and malformed success", () => { const old = manual(); const input = schedules.scheduleSaveInput(schedules.scheduleValues(old, old.scheduleDate), old); assert.equal(schedules.isScheduleMutation({ ok: true, message: "동일", change: "unchanged", item: old }, input, old), true); assert.equal(schedules.isScheduleMutation({ ok: true, message: "수정", change: "update", item: old }, input, old), false); assert.equal(schedules.isScheduleDelete({ ok: true, message: "없음", change: "missing", deletedId: "manual-a" }, "manual-a"), true); assert.equal(schedules.isScheduleDelete({ ok: true, message: "없음", change: "missing", deletedId: "new-id" }, "manual-a"), false); });
test("safe history pages validate actors/snapshots and keep five per page", () => { const log = { id: "log-a", createdAt: stamp, actor: { id: "staff-a", name: "직원" }, change: "create", message: null, previous: null, next: { scheduleDate: "2026-10-03", startMinute: 540, endMinute: 600, content: "내용" } }; const response = { logs: [log], actors: [log.actor], actorId: "all", scheduleDate: "", page: 1, pageSize: 5, total: 1, totalPages: 1 }; assert.equal(schedules.isScheduleChanges(response), true); assert.equal(schedules.isScheduleChanges({ ...response, logs: [{ ...log, metadata: { IP: "private" } }] }), false); assert.equal(schedules.isScheduleChanges({ ...response, actors: [{ ...log.actor, email: "private" }] }), false); assert.equal(schedules.isScheduleChanges({ ...response, total: 6, totalPages: 2 }), false); assert.equal(schedules.formatScheduleTimestamp("2026-10-02T15:05:00.000Z"), "2026-10-03 00:05"); });
