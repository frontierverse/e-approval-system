test("actual web binary cookie auth precedes params and all failure/success statuses stay private",async()=>{h.session=null;let paramsRead=false;const params={then(){paramsRead=true;throw Error("invalid params read");}};for(const route of[webDownload,webPreview]){const response=await route.GET(new Request("https://fixture.invalid/resources/attachments/file"),{params});assert.equal(response.status,401);assert.equal(response.headers.get("cache-control"),"private, no-store");}assert.equal(paramsRead,false);h.session={user:actor};post();h.state.resourceAttachment.push({id:"file",resourceId:"post",originalName:"real.pdf",mimeType:"application/pdf",size:3,storageProvider:"local",storageKey:"private"});const context={params:Promise.resolve({id:"file"})};h.preview=false;const unsupported=await webPreview.GET(new Request("https://fixture.invalid"),context);assert.equal(unsupported.status,415);assert.equal(unsupported.headers.get("x-content-type-options"),"nosniff");h.preview=true;const response=await webDownload.GET(new Request("https://fixture.invalid"),context);assert.equal(response.status,200);assert.equal(response.headers.get("cache-control"),"private, no-store");await response.arrayBuffer();h.state.user[0].status="INACTIVE";assert.equal((await webDownload.GET(new Request("https://fixture.invalid"),context)).status,401);assert.deepEqual(h.writes,[]);});

