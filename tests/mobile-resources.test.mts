test("actual cron and domain expire40 across four grant-gated batches with public counts unchanged",async()=>{
  for(let i=0;i<40;i++)ready({id:`expired-${i}`,actorId:"deleted-user",state:"uploading",expiresAt:now,completedAt:null,finalKey:null,stagingKey:`resources/staging/expired-${i}`,lastGrantExpiresAt:new Date(now.getTime()+60000)});
  const originalSecret=process.env.CRON_SECRET;process.env.CRON_SECRET="synthetic-maintenance-only";h.maintenanceCalls=0;
  try{const response=await maintenanceRoute.GET(new Request("https://fixture.invalid/api/internal/resource-maintenance",{headers:{authorization:"Bearer synthetic-maintenance-only"}}));assert.equal(response.status,200);const summary=await response.json();assert.deepEqual({ok:summary.ok,checked:summary.checked,completed:summary.completed},{ok:true,checked:0,completed:0});assert.equal(summary.lanes.resource.expired,40);assert.equal(summary.lanes.resource.batches,4);assert.equal(summary.lanes.resource.failed,false);assert.equal(summary.lanes.approvedPurge.checked,0);assert.equal(h.maintenanceCalls,4);assert.equal(h.state.resourceUpload.filter((row:Row)=>row.state==="deleting").length,40);assert.equal(h.state.resourceFileCleanup.length,40);assert.deepEqual(h.storageDeletes,[]);assert.ok(h.state.resourceUpload.every((row:Row)=>row.originalName===null&&row.mimeType===null&&row.size===null));}
  finally{if(originalSecret===undefined)delete process.env.CRON_SECRET;else process.env.CRON_SECRET=originalSecret;}
});
